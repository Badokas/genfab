{
  "name": "genfab",
  "version": "1.0.1",
  "description": "Generate manufacturing outputs (gerbers, drill, BOM, netlist, pick-and-place) for a KiCad project.",
  "type": "module",
  "bin": {
    "genfab": "./dist/bin/genfab.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "genfab": "node ./bin/genfab.ts"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6.0"
  },
  "author": "void9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Badokas/genfab.git"
  },
  "bugs": {
    "url": "https://github.com/Badokas/genfab/issues"
  },
  "homepage": "https://github.com/Badokas/genfab#readme",
  "keywords": [
    "kicad",
    "gerber",
    "pcb",
    "bom",
    "pick-and-place",
    "manufacturing",
    "cli"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
